# npm run init generates real local values; these are safe placeholders.
POSTGRES_DB=widget_platform
POSTGRES_USER=widget
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://widget:replace-with-random-local-password@localhost:5433/widget_platform
DEMO_PASSWORD=replace-with-random-demo-password
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CUSTOMER_PORT=5500
GEO_MODE=mock
DEMO_CONTROLS=true
NOTIFICATION_MODE=console
IP_RATE_LIMIT=10
WIDGET_RATE_LIMIT=100
RATE_WINDOW_SECONDS=60
TRUST_PROXY_HOPS=0
JOB_POLL_MS=500
JOB_RETRY_MS=2000
JOB_MAX_ATTEMPTS=3
# Optional: tests create and drop an isolated schema in this database.
# TEST_DATABASE_URL=postgresql://widget:local-password@localhost:5433/widget_platform
